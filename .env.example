# Configuration names only. Supply actual values through your deployment secret manager.
DATABASE_URL=
PUBLIC_APP_URL=https://your-public-domain.example
EXPO_PUBLIC_DOMAIN=your-public-domain.example
STRIPE_WEBHOOK_SECRET=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
# Exact browser origins, comma separated. The public app origin is already allowed.
ALLOWED_ORIGINS=
# Set only to your verified ingress proxy count; do not blindly trust forwarded headers.
TRUST_PROXY_HOPS=0
# Never enable in production.
SEED_DEMO_DATA=false
